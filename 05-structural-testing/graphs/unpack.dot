digraph unpack {
  graph [bgcolor=transparent, nodesep=0.22, ranksep=0.30, pad=0.06];
  node [shape=box, fontname="Liberation Serif", fontsize=13, margin="0.10,0.05"];
  edge [fontname="Liberation Serif", fontsize=11, arrowsize=0.7];
  a [label="1  Вход", shape=oval];
  b [label="2  Длина ≥ 55?", shape=diamond];
  c [label="3  Сигнатура GENC?", shape=diamond];
  d [label="4  Версия 1?", shape=diamond];
  e [label="5  Параметры допустимы?", shape=diamond];
  f [label="6  Вернуть Container"];
  g [label="7  ErrTooShort"];
  h [label="8  ErrBadMagic"];
  i [label="9  ErrUnsupportedVersion"];
  j [label="10  ErrBadParams"];
  k [label="11  Выход", shape=oval];
  a -> b;
  b -> c [label="да"]; b -> g [label="нет"];
  c -> d [label="да"]; c -> h [label="нет"];
  d -> e [label="да"]; d -> i [label="нет"];
  e -> f [label="да"]; e -> j [label="нет"];
  f -> k; g -> k; h -> k; i -> k; j -> k;
}
